<section class="tab brev-ressources {{onglet.cssClass}}" data-group="primary" data-tab="ressources">

  <h3 class="brev-titre-section">{{localize 'BREVIAIRE.Fiche.usure'}}</h3>
  <div class="brev-grille-usure">
    {{#each usures}}
    <div class="brev-usure {{#if epuise}}brev-epuise{{/if}}">
      <span class="brev-jauge-label">{{label}}</span>
      <div class="brev-compteur">
        <button type="button" data-action="usure" data-usure="{{cle}}" data-delta="-1" aria-label="−1 cran">−</button>
        <b>{{de}}</b>
        <button type="button" data-action="usure" data-usure="{{cle}}" data-delta="1" aria-label="+1 cran">+</button>
      </div>
      <label class="brev-base">
        <span>{{localize 'BREVIAIRE.Usure.base'}}</span>
        <select name="{{nomBase}}">{{selectOptions choixBase selected=base}}</select>
      </label>
    </div>
    {{/each}}
  </div>

  <h3 class="brev-titre-section">{{localize 'BREVIAIRE.Fiche.blessuresGraves'}}</h3>
  <ul class="brev-liste brev-graves">
    {{#each blessuresGraves}}
    <li class="{{#unless active}}brev-soignee{{/unless}}">
      <select name="graves.{{index}}.type">{{selectOptions @root.choixBlessuresGraves selected=type}}</select>
      <input type="text" name="graves.{{index}}.sequelle" value="{{sequelle}}" placeholder="{{localize 'BREVIAIRE.Fiche.sequelle'}}">
      <button type="button" data-action="basculerBlessureGrave" data-index="{{index}}" aria-pressed="{{active}}"
        title="{{#if active}}{{localize 'BREVIAIRE.Fiche.active'}}{{else}}{{localize 'BREVIAIRE.Fiche.soignee'}}{{/if}}">
        <i class="fa-solid {{#if active}}fa-droplet{{else}}fa-bandage{{/if}}"></i>
      </button>
      <button type="button" data-action="supprimerBlessureGrave" data-index="{{index}}" aria-label="{{localize 'BREVIAIRE.Fiche.supprimer'}}"><i class="fa-solid fa-trash"></i></button>
    </li>
    {{else}}
    <li class="brev-vide">{{localize 'BREVIAIRE.Fiche.aucune'}}</li>
    {{/each}}
  </ul>
  <button type="button" class="brev-ajouter" data-action="ajouterBlessureGrave"><i class="fa-solid fa-plus"></i> {{localize 'BREVIAIRE.Fiche.ajouterBlessureGrave'}}</button>

  <h3 class="brev-titre-section">{{localize 'BREVIAIRE.Fiche.jetsDeMort'}}</h3>
  <div class="brev-mort">
    {{#each mort}}
    <button type="button" class="brev-case {{#if coche}}pleine{{/if}}" data-action="mort" data-index="{{index}}" aria-pressed="{{coche}}"><i class="fa-solid fa-skull"></i></button>
    {{/each}}
    <label class="brev-case-texte"><input type="checkbox" name="system.mort.stabilise" {{checked system.mort.stabilise}}> {{localize 'BREVIAIRE.Etat.stabilise'}}</label>
  </div>

  <h3 class="brev-titre-section">{{corruption.label}} — {{corruption.etat}} <small>({{localize 'BREVIAIRE.Fiche.deSang'}} {{corruption.deSang}})</small></h3>
  <div class="brev-corruption">
    {{#each corruption.cases}}
    <button type="button" class="brev-case {{#if pleine}}pleine{{/if}} {{#if palier}}palier{{/if}}" data-action="corruption" data-n="{{n}}" aria-label="{{n}}">{{n}}</button>
    {{/each}}
  </div>

  <h3 class="brev-titre-section">{{libelles.marques}}</h3>
  <ul class="brev-liste brev-marques">
    {{#each marques}}
    <li data-item-id="{{id}}">
      <img src="{{img}}" alt="">
      <div class="brev-marque-texte">
        <b>{{chiffre}} · {{titre}}</b>
        <span>{{texte}}</span>
      </div>
      <button type="button" data-action="editerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.editer'}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="supprimerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.supprimer'}}"><i class="fa-solid fa-trash"></i></button>
    </li>
    {{else}}
    <li class="brev-vide">{{localize 'BREVIAIRE.Fiche.aucune'}}</li>
    {{/each}}
  </ul>

  <h3 class="brev-titre-section">{{localize 'BREVIAIRE.Fiche.suivi'}}</h3>
  <div class="brev-champs">
    <label><span>{{localize 'BREVIAIRE.Fiche.missions'}}</span><input type="number" name="system.missions" value="{{system.missions}}" min="0"> <small>{{titre}}</small></label>
    <label><span>{{localize 'BREVIAIRE.Fiche.protectionNaturelle'}}</span><input type="number" name="system.protectionNaturelle" value="{{system.protectionNaturelle}}" min="0"></label>
    {{#if (eq camp "fideles")}}
    <label class="brev-case-texte"><input type="checkbox" name="system.excommunie" {{checked system.excommunie}}> {{localize 'BREVIAIRE.Fiche.excommunie'}}</label>
    {{/if}}
  </div>
</section>
