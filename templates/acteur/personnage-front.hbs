<section class="brev-page brev-front {{onglet.cssClass}}" data-onglet="front">
  <p class="brev-legende">
    <span class="brev-pips">○○</span> {{localize 'BREVIAIRE.RangSpecialite.0'}}
    <span class="brev-pips">●○</span> {{localize 'BREVIAIRE.RangSpecialite.1'}} +2
    <span class="brev-pips">●●</span> {{localize 'BREVIAIRE.RangSpecialite.2'}} +4
    <span class="brev-coche-exemple">☑</span> {{localize 'BREVIAIRE.Fiche.cocheAide'}}
  </p>

  <div class="brev-grille-caracs">
    {{#each caracs}}
    <div class="brev-bloc-carac">
      <div class="brev-carac">
        <button type="button" class="brev-carac-jet" data-action="jet" data-carac="{{cle}}">{{label}}</button>
        <input class="brev-carac-valeur" type="number" name="system.caracs.{{cle}}" value="{{valeur}}" min="1" max="20" aria-label="{{label}}">
      </div>
      <ul class="brev-specialites">
        {{#each specialites}}
        <li class="brev-specialite rang-{{rang}}" data-specialite="{{cle}}">
          <button type="button" class="brev-pips" data-action="rangSpecialite" title="{{rangLabel}}" aria-label="{{label}} : {{rangLabel}}">{{pips}}</button>
          <button type="button" class="brev-nom-jet" data-action="jet" data-specialite="{{cle}}">{{label}}</button>
          <button type="button" class="brev-coche {{#if coche}}coche{{/if}}" data-action="coche" aria-pressed="{{coche}}" aria-label="{{localize 'BREVIAIRE.Fiche.coche'}}"></button>
          <span class="brev-score">{{score}}</span>
        </li>
        {{#each substitutions}}
        <li class="brev-specialite brev-substitution" data-specialite="{{../cle}}">
          <span class="brev-pips">↳</span>
          <button type="button" class="brev-nom-jet" data-action="jet" data-specialite="{{../cle}}" data-substitution="{{cle}}">{{label}} <small>{{carac}}</small></button>
          <span></span>
          <span class="brev-score">{{score}}</span>
        </li>
        {{/each}}
        {{/each}}
      </ul>
    </div>
    {{/each}}
  </div>

  <h3 class="brev-titre-section"><span>{{localize 'BREVIAIRE.Fiche.substitutions'}}</span></h3>
  <div class="brev-puces">
    {{#each substitutions}}
    <button type="button" class="brev-puce {{#if possede}}active{{else}}brev-seulement-edition{{/if}}" data-action="substitution" data-substitution="{{cle}}" aria-pressed="{{possede}}">
      <span>{{label}}</span><small>{{detail}}</small>
    </button>
    {{/each}}
  </div>
</section>
