<section class="brev-page brev-front {{onglet.cssClass}}" data-onglet="front">
  {{#if combat}}
  <div class="brev-combat-bandeau brev-panneau">
    <div class="brev-combat-phase phase-{{combat.valeur}}"><small>{{localize 'BREVIAIRE.Combat.tour'}} {{combat.round}}</small><b>{{combat.phase}}</b></div>
    <div class="brev-combat-actions">
      {{#if combat.eclair}}<button type="button" class="brev-jeu fort" data-action="combat" data-combat="eclair"><i class="fa-solid fa-bolt"></i> {{localize 'BREVIAIRE.Combat.assautEclair'}}</button>{{/if}}
      {{#if combat.reprendre}}<button type="button" class="brev-jeu" data-action="combat" data-combat="reprendre"><i class="fa-solid fa-forward"></i> {{localize 'BREVIAIRE.Combat.reprendre'}}</button>{{/if}}
      {{#if combat.panique}}<button type="button" class="brev-jeu fort" data-action="combat" data-combat="reprise"><i class="fa-solid fa-hand-fist"></i> {{localize 'BREVIAIRE.Combat.seReprendre'}}</button>{{/if}}
      <button type="button" class="brev-jeu {{#if combat.viseur}}on{{/if}}" data-action="combat" data-combat="viser"><i class="fa-solid fa-crosshairs"></i> {{localize 'BREVIAIRE.Combat.viser'}}</button>
      <button type="button" class="brev-jeu {{#if combat.couvert}}on{{/if}}" data-action="combat" data-combat="couvert"><i class="fa-solid fa-shield"></i> {{localize 'BREVIAIRE.Combat.aCouvert'}}</button>
      {{#if combat.plonge}}<button type="button" class="brev-jeu on" data-action="combat" data-combat="finPlonge"><i class="fa-solid fa-person-falling"></i> {{localize 'BREVIAIRE.Etat.plonge'}}</button>
      {{else}}<button type="button" class="brev-jeu" data-action="combat" data-combat="plonger"><i class="fa-solid fa-person-falling"></i> {{localize 'BREVIAIRE.Combat.plonger'}}</button>{{/if}}
    </div>
  </div>
  {{/if}}
  <div class="brev-front-grille">

    <div class="brev-panneau brev-panneau-specialites">
      <h3 class="brev-panneau-titre"><i class="fa-solid fa-list-check"></i> {{localize 'BREVIAIRE.Fiche.specialites'}} <small>{{nbMaitrisees}}</small></h3>
      <ul class="brev-lignes">
        {{#each specialitesListe}}
        <li class="brev-ligne-spe rang-{{rang}}" data-specialite="{{cle}}">
          <button type="button" class="brev-pips" data-action="rangSpecialite" data-tooltip="{{rangLabel}}" aria-label="{{label}} : {{rangLabel}}">{{pips}}</button>
          <span class="brev-abrev">{{abrev}}</span>
          <button type="button" class="brev-nom-jet" data-action="jet" data-specialite="{{cle}}">{{label}}</button>
          <button type="button" class="brev-coche {{#if coche}}coche{{/if}}" data-action="coche" aria-pressed="{{coche}}" data-tooltip="{{localize 'BREVIAIRE.Fiche.coche'}}" aria-label="{{localize 'BREVIAIRE.Fiche.coche'}}"></button>
          <span class="brev-score">{{score}}</span>
        </li>
        {{#each substitutions}}
        <li class="brev-ligne-spe brev-substitution" data-specialite="{{../cle}}">
          <span class="brev-pips">↳</span>
          <span class="brev-abrev">{{caracAbrev}}</span>
          <button type="button" class="brev-nom-jet" data-action="jet" data-specialite="{{../cle}}" data-substitution="{{cle}}">{{label}}</button>
          <span></span>
          <span class="brev-score">{{score}}</span>
        </li>
        {{/each}}
        {{/each}}
      </ul>
      <p class="brev-legende">
        <span class="brev-pips">●○</span> {{localize 'BREVIAIRE.RangSpecialite.1'}} +2
        <span class="brev-pips">●●</span> {{localize 'BREVIAIRE.RangSpecialite.2'}} +4
        <span class="brev-coche-exemple">☑</span> {{localize 'BREVIAIRE.Fiche.cocheAide'}}
      </p>
    </div>

    <div class="brev-front-droite">
      <div class="brev-panneau">
        <h3 class="brev-panneau-titre"><i class="fa-solid fa-shuffle"></i> {{localize 'BREVIAIRE.Fiche.substitutions'}}</h3>
        <div class="brev-puces">
          {{#each substitutions}}
          <button type="button" class="brev-puce {{#if possede}}active{{else}}brev-seulement-edition{{/if}}" data-action="substitution" data-substitution="{{cle}}" aria-pressed="{{possede}}">
            <span>{{label}}</span><small>{{detail}}</small>
          </button>
          {{/each}}
          {{#unless aSubstitution}}<p class="brev-vide brev-seulement-lecture">{{localize 'BREVIAIRE.Fiche.aucune'}}</p>{{/unless}}
        </div>
      </div>

      <div class="brev-panneau">
        <h3 class="brev-panneau-titre"><i class="fa-solid fa-layer-group"></i> {{localize 'BREVIAIRE.Fiche.arcanes'}}</h3>
        <ul class="brev-arcanes-creation">
          {{#each arcanesCreation}}
          <li>
            <div class="brev-mini-carte {{#unless nom}}vide{{/unless}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{chiffre}}</span></div>
            <div>
              <small>{{position}}</small>
              <b>{{#if nom}}{{nom}}{{else}}{{localize 'BREVIAIRE.Fiche.aucunArcane'}}{{/if}}</b>
              {{#if reponse}}<em>{{reponse}}</em>{{/if}}
            </div>
          </li>
          {{/each}}
        </ul>
      </div>

      <div class="brev-panneau">
        <h3 class="brev-panneau-titre"><i class="fa-solid fa-hand-sparkles"></i> {{libelles.marques}}</h3>
        <ul class="brev-marques-liste">
          {{#each marques}}
          <li data-item-id="{{id}}">
            <img src="{{img}}" alt="">
            <div class="brev-carte-corps">
              <b><span class="brev-chiffre">{{chiffre}}</span> {{titre}}</b>
              <span class="brev-carte-texte">{{{texte}}}</span>
            </div>
            <button type="button" data-action="editerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.editer'}}"><i class="fa-solid fa-pen"></i></button>
            <button type="button" class="brev-seulement-edition" data-action="supprimerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.supprimer'}}"><i class="fa-solid fa-trash"></i></button>
          </li>
          {{else}}
          <li class="brev-vide">{{localize 'BREVIAIRE.Fiche.aucune'}}</li>
          {{/each}}
        </ul>
      </div>
    </div>
  </div>
</section>
