<header class="brev-entete">
  <div class="brev-cadre-portrait">
    <img class="brev-portrait" src="{{document.img}}" alt="{{document.name}}" data-action="changerImage">
  </div>
  <div class="brev-identite">
    <input class="brev-nom" type="text" name="name" value="{{document.name}}" placeholder="{{localize 'BREVIAIRE.Fiche.nom'}}">
    <input class="brev-surnom" type="text" name="system.histoire.surnom" value="{{system.histoire.surnom}}" placeholder="{{localize 'BREVIAIRE.Fiche.surnom'}}">
    <div class="brev-ruban">
      <select name="system.rang" aria-label="{{localize 'BREVIAIRE.Fiche.rang'}}">{{selectOptions rangs selected=system.rang}}</select>
      {{#if system.affectation.nom}}<span class="brev-sep">✠</span><span>{{system.affectation.nom}}</span>{{/if}}
      {{#if system.origine.nom}}<span class="brev-sep">✠</span><span>{{system.origine.nom}}</span>{{/if}}
      <span class="brev-sceau-titre">{{titre}}</span>
    </div>
  </div>
  <div class="brev-medaillons">
    <div class="brev-medaillon brev-medaillon-blessures {{#if horsDeCombat}}brev-alerte{{/if}}">
      <span class="brev-medaillon-label">{{localize 'BREVIAIRE.Fiche.blessures'}}</span>
      <div class="brev-compteur">
        <button type="button" data-action="blessures" data-delta="-1" aria-label="−1"><i class="fa-solid fa-minus"></i></button>
        <b>{{system.blessures.value}}<small>/{{system.blessures.max}}</small></b>
        <button type="button" data-action="blessures" data-delta="1" aria-label="+1"><i class="fa-solid fa-plus"></i></button>
      </div>
    </div>
    <div class="brev-medaillon">
      <span class="brev-medaillon-label">{{localize 'BREVIAIRE.Fiche.protection'}}</span>
      <b>{{system.protection}}{{#if system.protectionBouclier}}<small>+{{system.protectionBouclier}}</small>{{/if}}</b>
    </div>
    <div class="brev-medaillon">
      <span class="brev-medaillon-label">{{localize 'BREVIAIRE.Fiche.deplacement'}}</span>
      <b>{{system.deplacement}}<small> m</small></b>
    </div>
    <div class="brev-medaillon brev-medaillon-sang">
      <span class="brev-medaillon-label">{{localize 'BREVIAIRE.Fiche.deSangCourt'}}</span>
      <b>{{corruption.deSang}}</b>
    </div>
  </div>
</header>
