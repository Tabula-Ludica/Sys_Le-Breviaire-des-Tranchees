<section class="tab brev-paquetage {{onglet.cssClass}}" data-group="primary" data-tab="paquetage">

  <div class="brev-entete-liste">
    <h3 class="brev-titre-section">{{localize 'TYPES.Item.arme'}}</h3>
    <button type="button" data-action="creerObjet" data-type="arme" aria-label="{{localize 'BREVIAIRE.Fiche.ajouter'}}"><i class="fa-solid fa-plus"></i></button>
  </div>
  <ul class="brev-liste brev-objets">
    {{#each armes}}
    <li data-item-id="{{id}}" class="{{#unless equipee}}brev-range{{/unless}}">
      <img src="{{img}}" alt="">
      <button type="button" class="brev-objet-nom" data-action="jet" data-arme="{{id}}">
        <b>{{name}}</b>
        <small>{{degats}}{{#if portee}} · {{portee}}{{/if}}{{#if particularites}} · {{particularites}}{{/if}}{{#if (ne quantite null)}} · ×{{quantite}}{{/if}}</small>
      </button>
      <button type="button" data-action="basculerEquipe" aria-pressed="{{equipee}}" aria-label="{{localize 'BREVIAIRE.Fiche.equipee'}}"><i class="fa-solid {{#if equipee}}fa-hand-fist{{else}}fa-box{{/if}}"></i></button>
      <button type="button" data-action="editerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.editer'}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="supprimerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.supprimer'}}"><i class="fa-solid fa-trash"></i></button>
    </li>
    {{else}}<li class="brev-vide">{{localize 'BREVIAIRE.Fiche.glisser'}}</li>{{/each}}
  </ul>

  <div class="brev-entete-liste">
    <h3 class="brev-titre-section">{{localize 'TYPES.Item.protection'}}</h3>
    <button type="button" data-action="creerObjet" data-type="protection" aria-label="{{localize 'BREVIAIRE.Fiche.ajouter'}}"><i class="fa-solid fa-plus"></i></button>
  </div>
  <ul class="brev-liste brev-objets">
    {{#each protections}}
    <li data-item-id="{{id}}" class="{{#unless equipee}}brev-range{{/unless}}">
      <img src="{{img}}" alt="">
      <div class="brev-objet-nom"><b>{{name}}</b><small>{{type}} · {{valeur}}</small></div>
      <button type="button" data-action="basculerEquipe" aria-pressed="{{equipee}}" aria-label="{{localize 'BREVIAIRE.Fiche.equipee'}}"><i class="fa-solid {{#if equipee}}fa-shield-halved{{else}}fa-box{{/if}}"></i></button>
      <button type="button" data-action="editerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.editer'}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="supprimerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.supprimer'}}"><i class="fa-solid fa-trash"></i></button>
    </li>
    {{else}}<li class="brev-vide">{{localize 'BREVIAIRE.Fiche.glisser'}}</li>{{/each}}
  </ul>

  <div class="brev-entete-liste">
    <h3 class="brev-titre-section">{{localize 'TYPES.Item.relique'}}</h3>
    <button type="button" data-action="creerObjet" data-type="relique" aria-label="{{localize 'BREVIAIRE.Fiche.ajouter'}}"><i class="fa-solid fa-plus"></i></button>
  </div>
  <ul class="brev-liste brev-objets">
    {{#each reliques}}
    <li data-item-id="{{id}}" class="{{#if utilisee}}brev-range{{/if}}">
      <img src="{{img}}" alt="">
      <div class="brev-objet-nom"><b>{{name}}</b><small>+{{apport}}d6 · {{@root.libelles.chapelet}}</small></div>
      <button type="button" data-action="editerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.editer'}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="supprimerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.supprimer'}}"><i class="fa-solid fa-trash"></i></button>
    </li>
    {{else}}<li class="brev-vide">{{localize 'BREVIAIRE.Fiche.aucune'}}</li>{{/each}}
  </ul>

  <div class="brev-entete-liste">
    <h3 class="brev-titre-section">{{localize 'TYPES.Item.equipement'}}</h3>
    <button type="button" data-action="creerObjet" data-type="equipement" aria-label="{{localize 'BREVIAIRE.Fiche.ajouter'}}"><i class="fa-solid fa-plus"></i></button>
  </div>
  <ul class="brev-liste brev-objets">
    {{#each equipement}}
    <li data-item-id="{{id}}">
      <img src="{{img}}" alt="">
      <div class="brev-objet-nom"><b>{{name}}</b>{{#if (gt quantite 1)}}<small>×{{quantite}}</small>{{/if}}</div>
      <button type="button" data-action="editerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.editer'}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" data-action="supprimerObjet" aria-label="{{localize 'BREVIAIRE.Fiche.supprimer'}}"><i class="fa-solid fa-trash"></i></button>
    </li>
    {{else}}<li class="brev-vide">{{localize 'BREVIAIRE.Fiche.aucune'}}</li>{{/each}}
  </ul>
</section>
